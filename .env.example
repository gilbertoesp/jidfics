# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Auth.js v5 (NextAuth) - One-Click OAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth Provider (add more providers as needed)
# Create at: https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: Set explicitly if not on Vercel (defaults to request host)
# AUTH_URL=https://myapp.local.yourcompany.dev

# Required when running behind a proxy (e.g., portless, ngrok) to trust X-Forwarded-Host
AUTH_TRUST_HOST=true